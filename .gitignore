# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local tooling output
.shots/
.apiref/

# Screenshots and screencasts handed over for a bug report. Useful in the moment,
# and not something to carry in the history — a screencast is nine megabytes.
temp/

# Python bytecode from the asset generators
__pycache__/
